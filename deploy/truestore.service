# Systemd service for TrueStore Operations (gunicorn).
#
# Customize: User/Group, WorkingDirectory, SECRET_KEY, and port.
# Then:
#   sudo cp deploy/truestore.service /etc/systemd/system/tsopr.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tsopr

[Unit]
Description=TrueStore Operations (Gunicorn)
After=network.target

[Service]
Type=simple
User=tsopr
Group=tsopr
WorkingDirectory=/opt/tsopr/app
Environment="FLASK_ENV=production"
Environment="SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE"
ExecStart=/opt/tsopr/app/.venv/bin/gunicorn -w 4 --capture-output -b 127.0.0.1:8020 wsgi:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
